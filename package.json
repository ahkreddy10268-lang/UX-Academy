{
  "name": "ux-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "content:index": "tsx scripts/generate-content-index.ts",
    "sources:verify": "tsx scripts/verify-sources.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:taxonomy": "tsx scripts/validate-taxonomy.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run content:index && npm run typecheck && npm run test && npm run lint",
    "docs:generate": "tsx scripts/generate-docs.ts"
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
